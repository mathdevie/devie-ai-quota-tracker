{
  "name": "devie-quota",
  "version": "0.15",
  "private": true,
  "description": "A local macOS menu bar app for AI subscription quotas",
  "homepage": "https://github.com/mathdevie/devie-ai-quota-tracker",
  "bugs": {
    "url": "https://github.com/mathdevie/devie-ai-quota-tracker/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mathdevie/devie-ai-quota-tracker.git"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "check": "vp check",
    "format": "vp check --fix",
    "bump": "bun scripts/bump.js",
    "tauri": "tauri",
    "dev:desktop": "tauri dev",
    "build:desktop": "tauri build",
    "i18n:status": "i18next-cli status",
    "i18n:lint": "i18next-cli lint",
    "i18n:extract": "i18next-cli extract --dry-run",
    "i18n:check": "i18n-check --locales src/i18n/messages --source en-US -f i18next -r summary",
    "i18n:check:undefined": "i18n-check --locales src/i18n/messages --source en-US -f i18next --unused src --only undefined -r standard",
    "i18n:check:unused": "i18n-check --locales src/i18n/messages --source en-US -f i18next --unused src --only unused -r summary --ignore '_Meta.*' 'Metadata.*' 'Tray.*' 'Notifications.*' 'Connection.Status.*' 'Login.Hint.*' 'Quota.Sort.*' 'Nav.Quota' 'Nav.Providers' 'Nav.Settings' 'Providers.EnableAccount' 'Providers.DisableAccount'",
    "i18n:untranslated": "bun scripts/i18n-untranslated.js",
    "i18n:verify": "run-s i18n:lint i18n:check i18n:check:undefined i18n:check:unused",
    "preview": "vp preview",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage",
    "test:native": "cargo test --locked --manifest-path src-desktop/Cargo.toml"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-positioner": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "i18next": "26.5.11",
    "lucide-react": "^1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9"
  },
  "devDependencies": {
    "@lingual/i18n-check": "^0.9.5",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@svgr/plugin-svgo": "8.1.0",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "i18next-cli": "1.80.5",
    "jsdom": "^30.1.3",
    "npm-run-all": "^4.1.5",
    "oxc-transform-react": "0.156.0",
    "sass": "1.106.1",
    "typescript": "^7",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  }
}
