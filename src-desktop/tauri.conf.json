{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Devie QT",
  "version": "0.2.0",
  "identifier": "com.devie.qt",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3002",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build:desktop-frontend"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": ["'self'", "tauri:", "asset:"],
        "base-uri": ["'self'"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "https://cdn.crabnebula.app"
        ],
        "font-src": ["'self'", "data:"],
        "form-action": ["'self'"],
        "frame-ancestors": ["'none'"],
        "img-src": ["'self'", "asset:", "data:"],
        "object-src": ["'none'"],
        "script-src": ["'self'"],
        "style-src": ["'self'", "'unsafe-inline'"]
      },
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4Njc1MkVGMkUxNEY0RjYKUldUMjlCUXU3MUpuV0ZFaWJITFhEWHVWbWdZOWlwV2xmQmZEaEU0Y0hGeGI2ZGZNNm82RlYvSksK",
      "endpoints": [
        "https://cdn.crabnebula.app/update/mathdev/devie-qt/{{target}}-{{arch}}/{{current_version}}"
      ]
    }
  }
}
